import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Page, Sidebar } from "components/sidebar.slint";
import { SecondaryText } from "components/panel.slint";
import { DashboardPage, DriveCardData } from "pages/dashboard.slint";
import { DirectoryDisplay, ScanDisplay, ScanPage, ScanPhase } from "pages/scan.slint";
import { CleanupPage } from "pages/cleanup.slint";
import { SettingsPage } from "pages/settings.slint";

export { DirectoryDisplay, DriveCardData, ScanDisplay, ScanPhase }

export component AppWindow inherits Window {
    in property <[DriveCardData]> drives;
    in property <string> total-space;
    in property <string> used-space;
    in property <string> free-space;
    in property <bool> loading-drives;
    in property <string> drive-error;
    in property <string> drive-notice;
    in property <string> app-version;
    in property <ScanPhase> scan-phase: ScanPhase.idle;
    in property <ScanDisplay> scan-progress;
    in property <[DirectoryDisplay]> scan-directories;
    in property <string> scan-root;
    in property <string> scan-error;
    in property <bool> picking-scan-folder;
    callback refresh-drives();
    callback scan-drive(string);
    callback pick-scan-folder();
    callback cancel-scan();
    private property <Page> active-page: Page.dashboard;
    private property <bool> scan-busy:
        root.picking-scan-folder || root.scan-phase == ScanPhase.scanning || root.scan-phase == ScanPhase.cancelling;

    function show-scan() {
        root.active-page = Page.scan;
        content.content-y = 0px;
    }

    title: "ByteBroom";
    background: Theme.canvas;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 870px;
    min-height: 480px;
    default-font-size: 14px;

    HorizontalLayout {
        Sidebar {
            current-page: root.active-page;
            navigate(page) => {
                root.active-page = page;
                content.content-y = 0px;
            }
        }

        content := ScrollView {
            accessible-role: main;
            accessible-label: "Page content";
            horizontal-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;

            VerticalLayout {
                padding: 32px;
                spacing: 26px;
                alignment: start;

                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.active-page == Page.dashboard ? "Dashboard" :
                                root.active-page == Page.scan ? "Scan" :
                                root.active-page == Page.cleanup ? "Cleanup" : "Settings";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 720;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.active-page == Page.dashboard || root.active-page == Page.scan: Button {
                            text: root.picking-scan-folder ? "Opening picker…" : "Scan a folder…";
                            enabled: !root.scan-busy;
                            height: 34px;
                            clicked => {
                                root.show-scan();
                                root.pick-scan-folder();
                            }
                        }
                        if root.active-page == Page.dashboard: Button {
                            text: root.loading-drives ? "Refreshing…" : "Refresh";
                            enabled: !root.loading-drives;
                            min-width: 106px;
                            height: 34px;
                            clicked => { root.refresh-drives(); }
                        }
                    }
                    SecondaryText {
                        text: root.active-page == Page.dashboard ? "View capacity and free space for your Windows drives." :
                            root.active-page == Page.scan ? "Measure logical file sizes in a drive or folder." :
                            root.active-page == Page.cleanup ? "Preview where cleanup candidates will appear for review." :
                            "View the default appearance and application version.";
                    }
                }

                if root.active-page == Page.dashboard: DashboardPage {
                    drives: root.drives;
                    total-space: root.total-space;
                    used-space: root.used-space;
                    free-space: root.free-space;
                    loading: root.loading-drives;
                    error: root.drive-error;
                    notice: root.drive-notice;
                    scan-enabled: !root.scan-busy;
                    scan-drive(letter) => {
                        root.show-scan();
                        root.scan-drive(letter);
                    }
                }
                if root.active-page == Page.scan: ScanPage {
                    phase: root.scan-phase;
                    progress: root.scan-progress;
                    directories: root.scan-directories;
                    scan-root: root.scan-root;
                    error: root.scan-error;
                    cancel => { root.cancel-scan(); }
                }
                if root.active-page == Page.cleanup: CleanupPage { }
                if root.active-page == Page.settings: SettingsPage { app-version: root.app-version; }
            }
        }
    }
}
