import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Glyph, Icon } from "../components/icon.slint";
import { EmptyState, Panel, PanelHeading, SecondaryText } from "../components/panel.slint";

export struct DriveCardData {
    letter: string,
    name: string,
    kind: string,
    total: string,
    used: string,
    free: string,
    usage: string,
    used-ratio: float,
}

component MetricCard inherits Panel {
    in property <Glyph> glyph;
    in property <string> label;
    in property <string> value;
    in property <color> ink: Theme.accent;
    min-width: 130px;
    height: 122px;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 15px;
        spacing: 7px;
        alignment: start;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: Theme.raised;
            Icon { glyph: root.glyph; ink: root.ink; size: 16px; }
        }
        Text { text: root.label; color: Theme.secondary; font-size: 12px; }
        Text { text: root.value; color: root.ink; font-size: 25px; font-weight: 700; }
    }
}

component DriveValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> ink: Theme.text;
    horizontal-stretch: 1;
    spacing: 3px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; }
    Text { text: root.value; color: root.ink; font-size: 15px; font-weight: 650; }
}

component DriveCard inherits Panel {
    in property <DriveCardData> drive;
    in property <bool> scan-enabled;
    callback scan();
    min-width: 265px;
    height: 203px;
    horizontal-stretch: 1;
    private property <color> usage-ink: root.drive.used-ratio >= 0.9 ? Theme.warning : Theme.used;

    VerticalLayout {
        padding: 17px;
        spacing: 14px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 38px;
                height: 36px;
                border-radius: 8px;
                background: Theme.selected;
                Text {
                    text: root.drive.letter;
                    color: Theme.accent;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.drive.name == "" ? root.drive.kind : root.drive.name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 650;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.drive.name != "": Text {
                    text: root.drive.kind;
                    color: Theme.secondary;
                    font-size: 12px;
                }
            }
            Text {
                text: root.drive.usage;
                color: root.usage-ink;
                font-size: 13px;
                font-weight: 650;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: Theme.free;
            clip: true;

            Rectangle {
                x: 0;
                width: parent.width * root.drive.used-ratio;
                background: root.usage-ink;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            DriveValue { label: "Total"; value: root.drive.total; }
            DriveValue { label: "Used"; value: root.drive.used; }
            DriveValue { label: "Free"; value: root.drive.free; }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Scan";
                accessible-label: "Scan drive " + root.drive.letter;
                enabled: root.scan-enabled;
                height: 30px;
                min-width: 68px;
                clicked => { root.scan(); }
            }
        }
    }
}

export component DashboardPage inherits VerticalLayout {
    in property <[DriveCardData]> drives;
    in property <string> total-space;
    in property <string> used-space;
    in property <string> free-space;
    in property <bool> loading;
    in property <string> error;
    in property <string> notice;
    in property <bool> scan-enabled;
    callback scan-drive(string);
    private property <bool> has-drives: root.drives.length > 0;
    spacing: 20px;
    alignment: start;

    if root.has-drives: VerticalLayout {
        spacing: 12px;
        PanelHeading { text: "Storage overview"; }
        HorizontalLayout {
            spacing: 12px;
            MetricCard { glyph: Glyph.drive; label: "Listed drive capacity"; value: root.total-space; ink: Theme.text; }
            MetricCard { glyph: Glyph.used; label: "Used space"; value: root.used-space; }
            MetricCard { glyph: Glyph.free; label: "Free space"; value: root.free-space; ink: Theme.text; }
        }
    }

    if root.has-drives: VerticalLayout {
        spacing: 12px;
        PanelHeading { text: "Drives"; }
        if root.loading: SecondaryText { text: "Refreshing drive information…"; }
        if root.notice != "": SecondaryText {
            text: root.notice;
            color: Theme.warning;
        }
        FlexboxLayout {
            spacing: 12px;
            alignment: stretch;
            for drive in root.drives: DriveCard {
                drive: drive;
                scan-enabled: root.scan-enabled;
                scan => { root.scan-drive(drive.letter); }
            }
        }
    }
    if root.loading && !root.has-drives: EmptyState {
        glyph: Glyph.drive;
        title: "Discovering drives…";
        detail: "Reading Windows volume capacity.";
    }
    if !root.loading && root.error != "": EmptyState {
        glyph: Glyph.drive;
        title: "Couldn’t load drive information";
        detail: root.error;
    }
    if !root.loading && root.error == "" && !root.has-drives: EmptyState {
        glyph: Glyph.drive;
        title: "No drives found";
        detail: "Connect a drive and select Refresh.";
    }
}
