import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Page, Sidebar } from "components/sidebar.slint";
import { SecondaryText } from "components/panel.slint";
import { DashboardPage, DriveCardData } from "pages/dashboard.slint";
import { DirectoryDisplay, ScanDisplay, ScanPage, ScanPhase } from "pages/scan.slint";
import { CleanupPage } from "pages/cleanup.slint";
import { SettingsPage } from "pages/settings.slint";
import { ArtifactDetails, ArtifactFilter, ArtifactPage, ArtifactRow, ArtifactSummary } from "pages/artifacts.slint";
import { AnalysisCard, AnalysisDetail, AnalysisEntry, AnalysisFilter, AnalysisTile, AnalyzerPage } from "pages/analyzer.slint";
import { DevelopmentPage, StorageDetails, StorageFilter, StorageGroup, StoragePhase, StorageRow, StorageSummary } from "pages/development.slint";

export { DirectoryDisplay, DriveCardData, ScanDisplay, ScanPhase }
export { ArtifactDetails, ArtifactFilter, ArtifactRow, ArtifactSummary }
export { AnalysisCard, AnalysisDetail, AnalysisEntry, AnalysisFilter, AnalysisTile }
export { StorageDetails, StorageFilter, StorageGroup, StoragePhase, StorageRow, StorageSummary }

export component AppWindow inherits Window {
    in property <int> analysis-mode;
    in property <int> analysis-snapshot;
    in property <int> analysis-selected: -1;
    in property <[string]> analysis-snapshots;
    in property <[string]> analysis-trail;
    in property <[string]> analysis-facets;
    in property <[AnalysisCard]> analysis-cards;
    in property <[AnalysisEntry]> analysis-rows;
    in property <[AnalysisTile]> analysis-tiles;
    in property <AnalysisFilter> analysis-filter;
    in property <AnalysisDetail> analysis-details;
    in property <string> analysis-root;
    in property <string> analysis-notice;
    in property <string> analysis-matches;
    in property <string> analysis-page-label;
    in property <bool> analysis-previous-page;
    in property <bool> analysis-next-page;
    in property <bool> analysis-available;
    in property <bool> analysis-limited;
    in property <[string]> analysis-comparison;
    in property <string> analysis-comparison-note;
    callback analysis-mode-changed(int);
    callback analysis-snapshot-changed(int);
    callback analysis-select(int);
    callback analysis-breadcrumb(int);
    callback analysis-page(int);
    callback analysis-filter-changed(AnalysisFilter);
    callback analysis-resize(float, float);
    callback analysis-enter();
    callback analysis-rescan();
    callback analysis-forget-previous();
    in property <string> last-analyzed-drive;
    in property <string> last-drive-analysis;
    in property <[DriveCardData]> drives;
    in property <string> total-space;
    in property <string> used-space;
    in property <string> free-space;
    in property <bool> loading-drives;
    in property <string> drive-error;
    in property <string> drive-notice;
    in property <string> app-version;
    in property <ScanPhase> scan-phase: ScanPhase.idle;
    in property <ScanDisplay> scan-progress;
    in property <[DirectoryDisplay]> scan-directories;
    in property <string> scan-root;
    in property <string> scan-error;
    in property <bool> picking-scan-folder;
    in property <ArtifactSummary> artifact-summary;
    in property <ArtifactFilter> artifact-filter;
    in property <ArtifactDetails> artifact-details;
    in property <[ArtifactRow]> artifact-rows;
    in property <[string]> artifact-ecosystems;
    in property <[string]> artifact-categories;
    in property <[string]> artifact-reviews;
    in property <string> artifact-project;
    in property <string> artifact-page;
    in property <bool> artifact-previous;
    in property <bool> artifact-next;
    in property <bool> artifact-partial;
    in property <bool> artifact-truncated;
    in property <StoragePhase> cache-phase;
    in property <StorageSummary> cache-summary;
    in property <StorageFilter> cache-filters;
    in property <StorageDetails> cache-details;
    in property <[StorageRow]> cache-rows;
    in property <[StorageGroup]> cache-groups;
    in property <[string]> cache-providers;
    in property <[string]> cache-choices;
    in property <string> cache-custom-summary;
    in property <string> cache-progress;
    in property <string> cache-notice;
    in property <string> cache-scope;
    in property <string> cache-page-label;
    in property <bool> cache-can-measure;
    in property <bool> cache-can-previous;
    in property <bool> cache-can-next;
    callback refresh-drives();
    callback scan-drive(string);
    callback pick-scan-folder();
    callback cancel-scan();
    callback filter-artifacts(ArtifactFilter);
    callback artifact-turn-page(int);
    callback artifact-select(int);
    callback artifact-clear-project();
    callback cache-discover(int);
    callback cache-add-custom(int, string);
    callback cache-clear-custom();
    callback cache-measure();
    callback cache-cancel();
    callback cache-filter(StorageFilter);
    callback cache-turn(int);
    callback cache-select(int, bool);
    callback cache-select-filtered(bool);
    callback cache-inspect(int);
    private property <Page> active-page: Page.dashboard;
    private property <bool> scan-busy:
        root.picking-scan-folder || root.scan-phase == ScanPhase.scanning || root.scan-phase == ScanPhase.cancelling
        || root.cache-phase == StoragePhase.discovering || root.cache-phase == StoragePhase.measuring || root.cache-phase == StoragePhase.cancelling;

    function show-scan() {
        root.active-page = Page.scan;
        content.content-y = 0px;
    }

    title: "ByteBroom";
    background: Theme.canvas;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 870px;
    min-height: 480px;
    default-font-size: 14px;

    HorizontalLayout {
        Sidebar {
            current-page: root.active-page;
            navigate(page) => {
                root.active-page = page;
                content.content-y = 0px;
            }
        }

        content := ScrollView {
            accessible-role: main;
            accessible-label: "Page content";
            horizontal-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;

            VerticalLayout {
                padding: 32px;
                spacing: 26px;
                alignment: start;

                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.active-page == Page.dashboard ? "Dashboard" :
                                root.active-page == Page.scan ? "Scan" :
                                root.active-page == Page.analyzer ? "Storage Analyzer" :
                                root.active-page == Page.artifacts ? "Developer Artifacts" :
                                root.active-page == Page.development ? "Development Storage" :
                                root.active-page == Page.cleanup ? "Cleanup" : "Settings";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 720;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.active-page == Page.dashboard || root.active-page == Page.scan || root.active-page == Page.analyzer: Button {
                            text: root.picking-scan-folder ? "Opening picker…" : "Scan a folder…";
                            enabled: !root.scan-busy;
                            height: 34px;
                            clicked => {
                                root.show-scan();
                                root.pick-scan-folder();
                            }
                        }
                        if root.active-page == Page.dashboard: Button {
                            text: root.loading-drives ? "Refreshing…" : "Refresh";
                            enabled: !root.loading-drives;
                            min-width: 106px;
                            height: 34px;
                            clicked => { root.refresh-drives(); }
                        }
                    }
                    SecondaryText {
                        text: root.active-page == Page.dashboard ? "View capacity and free space for your Windows drives." :
                            root.active-page == Page.scan ? "Measure logical file sizes in a drive or folder." :
                            root.active-page == Page.analyzer ? "Explore where measured storage is concentrated." :
                            root.active-page == Page.artifacts ? "Explore detected dependencies, caches, and build output." :
                            root.active-page == Page.development ? "Discover and measure shared caches, installed tools, and local environment data." :
                            root.active-page == Page.cleanup ? "Preview where cleanup candidates will appear for review." :
                            "View the default appearance and application version.";
                    }
                }

                if root.active-page == Page.dashboard: DashboardPage {
                    drives: root.drives;
                    total-space: root.total-space;
                    used-space: root.used-space;
                    free-space: root.free-space;
                    loading: root.loading-drives;
                    error: root.drive-error;
                    notice: root.drive-notice;
                    scan-enabled: !root.scan-busy;
                    last-analyzed-drive: root.last-analyzed-drive;
                    last-drive-analysis: root.last-drive-analysis;
                    scan-drive(letter) => {
                        root.show-scan();
                        root.scan-drive(letter);
                    }
                }
                if root.active-page == Page.scan: ScanPage {
                    phase: root.scan-phase;
                    progress: root.scan-progress;
                    directories: root.scan-directories;
                    scan-root: root.scan-root;
                    error: root.scan-error;
                    cancel => { root.cancel-scan(); }
                    view-analyzer => {
                        root.active-page = Page.analyzer;
                        content.content-y = 0px;
                    }
                    view-artifacts => {
                        root.active-page = Page.artifacts;
                        content.content-y = 0px;
                    }
                }
                if root.active-page == Page.analyzer: AnalyzerPage {
                    mode: root.analysis-mode;
                    snapshot: root.analysis-snapshot;
                    selected: root.analysis-selected;
                    snapshots: root.analysis-snapshots;
                    trail: root.analysis-trail;
                    facets: root.analysis-facets;
                    cards: root.analysis-cards;
                    rows: root.analysis-rows;
                    tiles: root.analysis-tiles;
                    filter: root.analysis-filter;
                    details: root.analysis-details;
                    path: root.analysis-root;
                    notice: root.analysis-notice;
                    matches: root.analysis-matches;
                    page-label: root.analysis-page-label;
                    previous-page: root.analysis-previous-page;
                    next-page: root.analysis-next-page;
                    available: root.analysis-available;
                    limited: root.analysis-limited;
                    comparison: root.analysis-comparison;
                    comparison-note: root.analysis-comparison-note;
                    busy: root.scan-busy;
                    side-details: root.width >= 980px;
                    scan-phase: root.scan-phase;
                    progress: root.scan-progress;
                    scan-error: root.scan-error;
                    running-path: root.scan-root;
                    mode-changed(mode) => { root.analysis-mode-changed(mode); }
                    snapshot-changed(snapshot) => { root.analysis-snapshot-changed(snapshot); }
                    select(id) => { root.analysis-select(id); }
                    breadcrumb(depth) => { root.analysis-breadcrumb(depth); }
                    page(delta) => { root.analysis-page(delta); }
                    apply(filter) => { root.analysis-filter-changed(filter); }
                    resize(width, height) => { root.analysis-resize(width, height); }
                    enter => { root.analysis-enter(); }
                    rescan => { root.analysis-rescan(); }
                    forget-previous => { root.analysis-forget-previous(); }
                    cancel => { root.cancel-scan(); }
                }
                if root.active-page == Page.artifacts: ArtifactPage {
                    phase: root.scan-phase;
                    progress: root.scan-progress;
                    summary: root.artifact-summary;
                    filters: root.artifact-filter;
                    details: root.artifact-details;
                    rows: root.artifact-rows;
                    ecosystems: root.artifact-ecosystems;
                    categories: root.artifact-categories;
                    reviews: root.artifact-reviews;
                    project: root.artifact-project;
                    page-label: root.artifact-page;
                    can-previous: root.artifact-previous;
                    can-next: root.artifact-next;
                    partial: root.artifact-partial;
                    truncated: root.artifact-truncated;
                    filter(new-filters) => { root.filter-artifacts(new-filters); }
                    turn-page(delta) => { root.artifact-turn-page(delta); }
                    select(index) => { root.artifact-select(index); }
                    clear-project => { root.artifact-clear-project(); }
                }
                if root.active-page == Page.development: DevelopmentPage {
                    phase: root.cache-phase;
                    scan-busy: root.scan-busy;
                    summary: root.cache-summary;
                    filters: root.cache-filters;
                    details: root.cache-details;
                    rows: root.cache-rows;
                    groups: root.cache-groups;
                    providers: root.cache-providers;
                    choices: root.cache-choices;
                    custom-summary: root.cache-custom-summary;
                    progress: root.cache-progress;
                    notice: root.cache-notice;
                    scope: root.cache-scope;
                    page-label: root.cache-page-label;
                    can-measure: root.cache-can-measure;
                    can-previous: root.cache-can-previous;
                    can-next: root.cache-can-next;
                    discover(provider) => { root.cache-discover(provider); }
                    add-custom(provider, path) => { root.cache-add-custom(provider, path); }
                    clear-custom => { root.cache-clear-custom(); }
                    measure => { root.cache-measure(); }
                    cancel => { root.cache-cancel(); }
                    filter(filters) => { root.cache-filter(filters); }
                    turn(delta) => { root.cache-turn(delta); }
                    select(index, checked) => { root.cache-select(index, checked); }
                    select-filtered(checked) => { root.cache-select-filtered(checked); }
                    inspect(index) => { root.cache-inspect(index); }
                }
                if root.active-page == Page.cleanup: CleanupPage { }
                if root.active-page == Page.settings: SettingsPage { app-version: root.app-version; }
            }
        }
    }
}
